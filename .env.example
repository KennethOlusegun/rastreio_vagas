# Exemplo de configuração de variáveis de ambiente para rastreio_vagas
# Renomeie este arquivo para .env e preencha com seus dados reais.
# O arquivo credentials.json do Google Sheets NÃO deve ser versionado.

GOOGLE_SHEETS_URL="https://docs.google.com/spreadsheets/d/SEU_ID_AQUI/edit#gid=0"
TELEGRAM_TOKEN_VAGAS="seu_token_telegram"
TELEGRAM_CHAT_ID_VAGAS="seu_chat_id"
ADZUNA_APP_ID="seu_app_id_adzuna"
ADZUNA_APP_KEY="seu_app_key_adzuna"
